{
  "name": "expense-analyzer",
  "version": "1.1.0",
  "description": "Markdown expense reports from Monzo (read-only via the wealth-dashboard DB, no download) or Wise/Revolut CSVs: category totals, top transactions, flagged unusual spends",
  "type": "skill",
  "category": "finance",
  "complexity": "intermediate",
  "tags": [
    "finance",
    "expenses",
    "monzo",
    "wise",
    "revolut",
    "python",
    "csv",
    "sqlite"
  ],
  "install": {
    "files": [
      {
        "src": "SKILL.md",
        "dest": "~/.claude/skills/expense-analyzer.md"
      },
      {
        "src": "scripts/analyze.py",
        "dest": "~/.claude/skills/expense-analyzer/scripts/analyze.py"
      }
    ]
  },
  "requirements": {
    "platform": "any",
    "mcp_servers": [],
    "env_vars": [],
    "python": ">=3.9"
  }
}
