      { "src": "references/rnd-titles.md", "dest": "~/.claude/skills/rnd-catalogue/references/rnd-titles.md" },
      { "src": "references/rnd-departments.md", "dest": "~/.claude/skills/rnd-catalogue/references/rnd-departments.md" }
